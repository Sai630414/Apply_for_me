# ApplyForMe Backend Configuration

# Application
APP_NAME=ApplyForMe
APP_ENV=development
API_V1_PREFIX=/api
DEBUG=true

# MongoDB Configuration (MongoDB Atlas Azure or Local)
# Example Atlas Azure URI: mongodb+srv://<username>:<password>@applyforme-azure.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=applyforme

# Authentication & Security
# Generate secure key via: openssl rand -hex 32
JWT_SECRET_KEY=applyforme_super_secret_jwt_key_change_in_production_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=1013825208923-8heisrtu7lc0e7i14mdu4r1p14k0dsdk.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LLM Provider Configuration (Local Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.4

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,chrome-extension://dccdppkggcalleledhmbclldddnokhok

